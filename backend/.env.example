# Shared infrastructure
POSTGRES_USER=tripsheet
POSTGRES_PASSWORD=tripsheet
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Internal service-to-service auth (gateway ↔ company-service ↔ auth-service)
INTERNAL_API_KEY=tripsheet-internal-dev

# Gateway (also loaded via preload-env when services start)
CORS_ORIGIN=http://localhost:5173
TENANT_RUNTIME_MODE=enforce

# JWT (shared secret for auth + gateway validation later)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Cloudinary (Phase 2 — document uploads via driver-service)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tripsheet/documents

# Service URLs (used by gateway)
GATEWAY_PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
COMPANY_SERVICE_URL=http://localhost:3002
DRIVER_SERVICE_URL=http://localhost:3003
FLEET_SERVICE_URL=http://localhost:3004
MANIFEST_SERVICE_URL=http://localhost:3005
TRIPSHEET_SERVICE_URL=http://localhost:3006
ACCOUNTING_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008

# Twilio (optional — notification-service; without these, SMS is simulated)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Model A email (multi-tenant) via SMTP ──
# One platform From for all tenants; each tenant sets display name + reply-to in app.
# MKX: "MKX Logistics" <noreply@yourdomain.com>  Reply-To: harry@mkx.com
# XYZ: "XYZ Transport" <noreply@yourdomain.com>  Reply-To: james@xyz.com
#
# SMTP_USER/SMTP_PASS = relay login (hidden). PLATFORM_FROM_EMAIL = visible From address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-relay@example.com
SMTP_PASS=your-app-password
PLATFORM_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM=noreply@yourdomain.com
PLATFORM_EMAIL_FROM_NAME=FleetQuix
PLATFORM_REPLY_TO=support@yourdomain.com

# Public app URL for password-reset and invite links (auth + driver services)
APP_PUBLIC_ORIGIN=http://localhost:5173
INVITE_PUBLIC_ORIGIN=http://localhost:5173

# Database URLs
AUTH_DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/auth_db?schema=public
COMPANY_DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/company_db?schema=public
DRIVER_DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/driver_db?schema=public
FLEET_DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/fleet_db?schema=public
MANIFEST_DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/manifest_db?schema=public
TRIPSHEET_DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/tripsheet_db?schema=public
ACCOUNTING_DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/accounting_db?schema=public
NOTIFICATION_DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/notification_db?schema=public
