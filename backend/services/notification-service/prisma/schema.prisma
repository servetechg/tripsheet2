generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NotificationLog {
  id         String   @id @default(cuid())
  companyId  String?
  channel    String   @default("sms")
  to         String
  body       String
  status     String
  providerId String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([channel])
  @@index([createdAt])
}

model Message {
  id         String   @id @default(cuid())
  companyId  String
  threadType String   @default("driver") // driver | internal | customer
  fromUserId String
  fromName   String   @default("")
  toUserId   String?
  toName     String   @default("")
  loadId     String?
  body       String
  readAt     String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([toUserId])
  @@index([loadId])
}

model Comment {
  id         String   @id @default(cuid())
  companyId  String
  entityType String // load | invoice | asset | sheet
  entityId   String
  userId     String
  userName   String   @default("")
  body       String
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([entityType, entityId])
}

model FcmDevice {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  token     String    @unique
  platform  String    @default("web")
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  @@index([companyId, userId])
  @@index([userId])
}

model InAppNotification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  title     String
  body      String
  link      String?
  type      String    @default("general")
  readAt    DateTime?
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([companyId, userId, createdAt])
  @@index([userId, readAt])
}
