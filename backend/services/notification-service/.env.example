PORT=3008
DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/notification_db?schema=public
REDIS_URL=redis://localhost:6379
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP / platform email — configure in backend/.env (shared).
# Do not set blank SMTP_* here; empty values override shared config.

COMPANY_SERVICE_URL=http://localhost:3002
INTERNAL_API_KEY=tripsheet-internal-dev
EMAIL_PROFILE_CACHE_TTL_MS=60000
PLATFORM_FROM_EMAIL=
PLATFORM_EMAIL_FROM_NAME=FleetQuix
PLATFORM_REPLY_TO=
TENANT_DB_SCHEMA=notification
TENANT_CACHE_TTL_MS=60000

# Firebase Cloud Messaging (web push)
FIREBASE_PROJECT_ID=fleetquix-official
# 1) Firebase Console → Project settings → Service accounts → Generate new private key
# 2) Save as backend/secrets/firebase-admin.json (copy from firebase-admin.json.example layout)
# Or one-line JSON (no file):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional custom path:
# GOOGLE_APPLICATION_CREDENTIALS=../../secrets/firebase-admin.json
# Set to 0 to disable mirroring email events to web push
# PUSH_MIRROR_EMAIL=1
