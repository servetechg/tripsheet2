generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id                String   @id @default(cuid())
  companyId         String
  type              String // truck | trailer | equipment
  unitNo            String
  year              String?
  make              String?
  model             String?
  vin               String?
  plate             String?
  /// available | assigned | maintenance | out_of_service | retired
  status            String   @default("available")
  insuranceExpiry   String?
  plateExpiry       String?
  permitExpiry      String?
  notes             String?
  /// MDM Phase 1: EquipmentType.code (company catalog)
  equipmentTypeCode String?
  /// Phase 5: branch assignment
  branchId          String?
  /// MDM Phase 6 optional insurance provider (snapshot + id)
  insuranceProviderId   String?
  insuranceProviderName String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, unitNo])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
}

/// Chapter 5 MDM Phase 1 — equipment catalog (Dry Van, Reefer, …)
model EquipmentType {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  system    Boolean  @default(false)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

model Load {
  id               String   @id @default(cuid())
  companyId        String
  driverId         String?
  truckId          String?
  trailerId        String?
  status           String   @default("assigned") // assigned|in_transit|delivered|cancelled
  origin           String
  destination      String
  pickupTime       String?
  eta              String?
  actualDelivery   String?
  tripNo           String?
  notes            String?
  truckNo          String?
  trailerNo        String?
  // Economics
  customerRate     Float    @default(0)
  carrierCost      Float    @default(0)
  fuelSurcharge    Float    @default(0)
  accessorials     Float    @default(0)
  detentionHours   Float    @default(0)
  detentionRate    Float    @default(0)
  miles            Float    @default(0)
  // Multi-stop: [{seq, location, stopType, scheduledAt, arrivedAt, departedAt, notes}]
  stops            Json     @default("[]")
  lat              Float?
  lng              Float?
  speed            Float?
  heading          String?
  lastUpdate       String?
  /// Phase 5: branch assignment
  branchId         String?
  /// MDM Phase 2 party/place refs (company_local masters)
  brokerId         String?
  customerId       String?
  originLocationId String?
  destinationLocationId String?
  brokerName       String?
  /// MDM Phase 3 subcontract carrier (≠ CarrierProfile)
  carrierId        String?
  carrierName      String?
  /// MDM Phase 4 commodity catalog snapshot
  commodityId      String?
  commodityName    String?
  /// MDM Phase 5 cross-border / POE
  crossBorder      Boolean  @default(false)
  portOfEntryId    String?
  portOfEntryCode  String?
  portOfEntryName  String?
  customsProgram   String?  // ACE | ACI
  customsAce       Boolean  @default(false)
  customsAci       Boolean  @default(false)
  customsPaps      Boolean  @default(false)
  customsPars      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
  @@index([driverId])
  @@index([status])
  @@index([branchId])
  @@index([brokerId])
  @@index([carrierId])
  @@index([commodityId])
  @@index([portOfEntryId])
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  companyId   String
  assetId     String
  unitNo      String   @default("")
  type        String   @default("repair") // pm | repair
  title       String
  description String   @default("")
  cost        Float    @default(0)
  performedAt String
  nextDueAt   String?
  odometer    Float?
  vendor      String   @default("")
  /// MDM Phase 6 optional vendor master
  vendorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([assetId])
}

model DvirInspection {
  id          String   @id @default(cuid())
  companyId   String
  assetId     String
  unitNo      String   @default("")
  driverId    String?
  driverName  String   @default("")
  inspectedAt String
  status      String   @default("satisfactory") // satisfactory | defects | out_of_service
  defects     Json     @default("[]") // [{area, note, critical}]
  remarks     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([assetId])
}
