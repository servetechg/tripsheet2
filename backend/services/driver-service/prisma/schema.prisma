generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Driver {
  id             String           @id @default(cuid())
  companyId      String
  userId         String?
  name           String
  email          String
  phone          String?
  dob            String?
  licenseNo      String?
  citizenship    String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  fastCard       String?
  notes          String?
  sin            String?
  active         Boolean          @default(true)
  branchId       String?

  lifecycleStatus   String          @default("active")
  availabilityStatus String         @default("available")
  driverType        String           @default("company")

  employeeNumber     String?
  employmentStatus String?
  hireDate           String?
  probationEndDate   String?
  seniorityDate      String?
  managerUserId      String?
  dispatcherUserId   String?
  preferredName      String?
  preferredLanguage  String?
  ownerOperatorProfile Json?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  documents      DriverDocument[]
  contracts      Contract[]
  qualifications DriverQualification[]
  equipmentAssignments DriverEquipmentAssignment[]
  safetyEvents   DriverSafetyEvent[]
  trainingRecords DriverTrainingRecord[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([branchId])
  @@index([lifecycleStatus])
  @@index([availabilityStatus])
  @@index([driverType])
}

model DriverQualification {
  id               String   @id @default(cuid())
  companyId        String
  driverId         String
  type             String
  number           String?
  class            String?
  endorsements     Json?
  issueDate        String?
  expiryDate       String?
  issuingAuthority String?
  documentId       String?
  status           String   @default("missing")
  ocrData          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([companyId])
  @@index([type])
}

model DriverEquipmentAssignment {
  id               String    @id @default(cuid())
  companyId        String
  driverId         String
  assetId          String
  assetType        String
  role             String    @default("primary")
  unitNo           String?
  assignedAt       DateTime  @default(now())
  unassignedAt     DateTime?
  assignedByUserId String?
  notes            String?
  driver           Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([companyId])
  @@index([assetId])
}

model DriverSafetyEvent {
  id          String   @id @default(cuid())
  companyId   String
  driverId    String
  type        String
  occurredAt  String
  description String
  preventable Boolean?
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([companyId])
}

model DriverTrainingRecord {
  id                    String   @id @default(cuid())
  companyId             String
  driverId              String
  courseCode            String
  courseName            String?
  completedAt           String
  expiryDate            String?
  instructor            String?
  certificateDocumentId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  driver                Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([companyId])
}

model DriverDocument {
  id                 String   @id @default(cuid())
  driverId           String
  companyId          String
  type               String
  fileName           String
  fileSize           Int?
  fileType           String?
  fileUrl            String?
  cloudinaryPublicId String?
  fileData           String?
  uploadedAt         String
  expiryDate         String?
  notes              String?
  status             String   @default("uploaded")
  driver             Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([driverId])
  @@index([companyId])
}

model Contract {
  id              String   @id @default(cuid())
  driverId        String
  companyId       String
  driverName      String?
  companyName     String?
  startDate       String?
  payType         String?
  payRate         String?
  payUnit         String?
  teamRate        String?
  detentionRate   String?
  waitRate        String?
  fuelSurcharge   String?
  vacationPct     String?
  trialDays       String?
  noticeDays      String?
  benefits        String?
  signedByDriver  Boolean  @default(false)
  signedByAdmin   Boolean  @default(false)
  signedAt        String?
  driverSignature String?
  adminSignature  String?
  payload         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model Invite {
  id          String   @id @default(cuid())
  token       String   @unique
  companyId   String
  status      String   @default("pending")
  kind        String   @default("driver")
  role        String   @default("driver")
  email       String?
  name        String?
  driverId    String?
  expiresAt   String?
  createdAt   String
  completedAt String?
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}
