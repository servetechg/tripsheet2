generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settlement {
  id          String   @id @default(cuid())
  companyId   String
  driverId    String
  driverName  String   @default("")
  periodStart DateTime
  periodEnd   DateTime
  status      String   @default("draft") // draft | approved | paid
  currency    String   @default("CAD")
  totalAmount Float    @default(0)
  lines       Json     @default("[]")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([driverId])
  @@index([status])
}

model LedgerAccount {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  type      String // asset | liability | equity | revenue | expense
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

model Invoice {
  id            String   @id @default(cuid())
  companyId     String
  customerName  String
  loadId        String?
  tripNo        String   @default("")
  status        String   @default("draft") // draft | sent | partial | paid | void
  issueDate     String
  dueDate       String
  currency      String   @default("CAD")
  subtotal      Float    @default(0)
  tax           Float    @default(0)
  total         Float    @default(0)
  amountPaid    Float    @default(0)
  lines         Json     @default("[]") // [{description, amount}]
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([loadId])
}

model Bill {
  id          String   @id @default(cuid())
  companyId   String
  vendorName  String
  status      String   @default("open") // open | partial | paid | void
  issueDate   String
  dueDate     String
  currency    String   @default("CAD")
  total       Float    @default(0)
  amountPaid  Float    @default(0)
  lines       Json     @default("[]")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

model Payment {
  id          String   @id @default(cuid())
  companyId   String
  direction   String // customer | vendor
  partyName   String
  invoiceId   String?
  billId      String?
  amount      Float
  method      String   @default("ach") // ach | wire | cheque | card | cash
  paidAt      String
  reference   String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([invoiceId])
  @@index([billId])
}
