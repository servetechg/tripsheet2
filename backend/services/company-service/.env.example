PORT=3002
DATABASE_URL=postgresql://tripsheet:tripsheet@localhost:5432/company_db?schema=public
# AES key for TenantDatabase.connectionCiphertext (Phase 1+)
PLATFORM_SECRETS_KEY=change-me-in-production
INTERNAL_API_KEY=tripsheet-internal-dev
# Admin URL used to CREATE DATABASE (connects to `postgres` DB). Needs CREATEDB.
# Defaults to DATABASE_URL host/user/password if unset.
TENANT_PROVISION_URL=postgresql://tripsheet:tripsheet@localhost:5432/postgres
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
# Phase 4: base URL for shared microservice DBs (path replaced with driver_db, etc.)
SHARED_DB_BASE=postgresql://tripsheet:tripsheet@localhost:5432/postgres
TENANT_DEFAULT_ROUTING_MODE=tenant
