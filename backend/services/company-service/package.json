{
  "name": "tripsheet-company-service",
  "version": "0.1.0",
  "description": "TripSheet Company Service",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/copy-sql-assets.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "provision:pending": "ts-node --transpile-only scripts/provision-pending-tenants.ts",
    "sync:tenant-schemas": "ts-node --transpile-only scripts/sync-tenant-schemas.ts",
    "migrate:tenants": "ts-node --transpile-only scripts/migrate-all-tenants.ts",
    "schema:migrate-all": "ts-node --transpile-only scripts/schema-migrate-all.ts",
    "test:rbac": "ts-node --transpile-only src/org/check-custom-roles.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
