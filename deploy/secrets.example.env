# Copy to /opt/tripsheet/secrets/ on the VPS. Never commit real values.
# chmod 700 /opt/tripsheet/secrets && chmod 600 /opt/tripsheet/secrets/*

# --- infra.env ---
POSTGRES_USER=tripsheet
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# --- app.env (production) ---
POSTGRES_USER=tripsheet
POSTGRES_PASSWORD=CHANGE_ME_same_as_infra
REDIS_PASSWORD=CHANGE_ME_same_as_infra
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=CHANGE_ME_openssl_rand_hex_32
# Encrypts tenant DB connection strings — keep stable after first tenant provision
PLATFORM_SECRETS_KEY=CHANGE_ME_openssl_rand_base64_48
# shared until MKX (or each company) is cut over to fq_tenant_* routing
TENANT_DEFAULT_ROUTING_MODE=shared
TENANT_RUNTIME_MODE=enforce
TENANT_CACHE_TTL_MS=60000
CORS_ORIGIN=https://tripsheet.YOUR_REAL_VPS_IP.sslip.io
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tripsheet/documents
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
IMAGE_REGISTRY=ghcr.io/servetechg/tripsheet2
IMAGE_TAG=latest
COLOR=blue

# --- staging.app.env ---
POSTGRES_USER=tripsheet
POSTGRES_PASSWORD=CHANGE_ME_same_as_infra
REDIS_PASSWORD=CHANGE_ME_same_as_infra
JWT_SECRET=CHANGE_ME_DIFFERENT_FROM_PROD
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=CHANGE_ME_DIFFERENT_FROM_PROD
PLATFORM_SECRETS_KEY=CHANGE_ME_DIFFERENT_FROM_PROD
TENANT_DEFAULT_ROUTING_MODE=shared
TENANT_RUNTIME_MODE=enforce
TENANT_CACHE_TTL_MS=60000
CORS_ORIGIN=https://staging.tripsheet.YOUR_REAL_VPS_IP.sslip.io
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tripsheet/staging/documents
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
IMAGE_REGISTRY=ghcr.io/servetechg/tripsheet2
IMAGE_TAG=staging

# --- edge.env ---
DOMAIN=tripsheet.YOUR_REAL_VPS_IP.sslip.io
STAGING_DOMAIN=staging.tripsheet.YOUR_REAL_VPS_IP.sslip.io
ACTIVE_COLOR=blue
CADDY_ACME_EMAIL=you@example.com
